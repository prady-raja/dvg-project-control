{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planning",
        "Active",
        "On Hold",
        "Completed",
        "Archived"
      ],
      "default": "Active"
    },
    "enabled_disciplines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Internal IDs of the disciplines enabled for this project"
    },
    "planned_villa_count": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "code"
  ]
}