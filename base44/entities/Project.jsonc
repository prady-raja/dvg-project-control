{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planning",
        "Active",
        "On Hold",
        "Completed",
        "Archived"
      ],
      "default": "Active"
    },
    "enabled_disciplines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Internal IDs of the disciplines enabled for this project"
    },
    "planned_villa_count": {
      "type": "number"
    },
    "working_days": {
      "type": "array",
      "items": { "type": "number" },
      "description": "Working weekdays, 1 = Monday to 7 = Sunday. Default Monday to Saturday."
    },
    "holidays": {
      "type": "array",
      "items": { "type": "string", "format": "date" },
      "description": "Non-working dates (festivals, site closures)"
    },
    "owner_signoff": { "type": "string", "enum": ["Optional", "Required"], "default": "Optional", "description": "Whether closing work in a handed-over villa needs the owner's acknowledgement (Q-08)" },
    "stale_days": {
      "type": "number",
      "description": "Working days without a site report before work is called stale"
    },
    "at_risk_window_days": {
      "type": "number",
      "description": "Working days before the finish date inside which unfinished work is at risk"
    },
    "backdate_limit_days": {
      "type": "number",
      "description": "How many days back a daily report may be dated"
    },
    "report_cutoff_time": {
      "type": "string",
      "description": "Time of day (HH:MM, IST) by which the day's reports are expected"
    },
    "site_lat": { "type": "number" },
    "site_lng": { "type": "number" },
    "notes": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "App users with active membership on this project. Maintained server-side."
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}