{
  "name": "Task",
  "type": "object",
  "properties": {
    "task_ref": {
      "type": "string",
      "description": "Permanent reference, e.g. IMG-A-0001"
    },
    "project_id": {
      "type": "string"
    },
    "phase_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "floor_id": {
      "type": "string",
      "description": "VillaFloor this work belongs to. Optional; a task may cover a whole villa."
    },
    "area_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "VillaArea ids this one task covers. Several rooms are one task with several ids, never duplicate task rows."
    },
    "area_label": {
      "type": "string",
      "description": "Readable scope, derived server-side from the floor and areas, e.g. 'First Floor \u00b7 Master Bedroom'. Empty while the scope is not registered."
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "Specific Room/Area",
        "Multiple Rooms/Areas",
        "Entire Floor",
        "Entire Villa",
        "Site-wide"
      ],
      "description": "How much of the villa this task covers. Derived from the floor and area ids when they are given."
    },
    "source_location_text": {
      "type": "string",
      "description": "The floor and room words exactly as the source work list wrote them. Kept so an unresolved location can be corrected against the original wording."
    },
    "scope_unresolved": {
      "type": "boolean",
      "default": false,
      "description": "True when a floor or room was named in the source list but is not registered. Such a task is never read as confirmed whole-villa work, is never completed by a villa-wide message, and is listed in Needs Attention."
    },
    "acceptance_criterion": {
      "type": "string",
      "description": "What must be true for this work to be accepted, e.g. 'Even finish, no visible joints, level checked with spirit level'."
    },
    "discipline": {
      "type": "string",
      "description": "Discipline code"
    },
    "work_package": {
      "type": "string"
    },
    "parent_task_id": {
      "type": "string"
    },
    "is_villa_work_parent": {
      "type": "boolean",
      "default": false,
      "description": "Villa Work assignment holding one child task per villa. Held out of work totals so parent and children are never double counted."
    },
    "villa_work_key": {
      "type": "string",
      "description": "Retry key for a multi-villa creation; also used per child to stop duplicate rows"
    },
    "child_villa_count": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "default": "Medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "Not Started",
        "In Progress",
        "Blocked",
        "Execution Complete",
        "Under Inspection",
        "Approved",
        "Closed"
      ],
      "default": "Not Started"
    },
    "contractor_id": {
      "type": "string"
    },
    "responsible_engineer": {
      "type": "string",
      "description": "The DVG engineer or coordinator responsible for this work. Left blank when the source list does not say, and reported as a data-quality gap."
    },
    "progress_percent": {
      "type": "number",
      "description": "Leave blank when progress is unknown"
    },
    "planned_quantity": {
      "type": "number"
    },
    "completed_quantity": {
      "type": "number"
    },
    "measurement_unit": {
      "type": "string"
    },
    "baseline_start": {
      "type": "string",
      "format": "date"
    },
    "baseline_finish": {
      "type": "string",
      "format": "date"
    },
    "baseline_approval_status": {
      "type": "string",
      "enum": [
        "Not Submitted",
        "Submitted",
        "Approved",
        "Rejected"
      ],
      "default": "Not Submitted"
    },
    "baseline_version_id": {
      "type": "string"
    },
    "baseline_locked": {
      "type": "boolean",
      "default": false,
      "description": "True once an approved baseline covers this task. No role, including an application administrator, may then change the baseline dates here: a revision is proposed and approved through the baseline workflow."
    },
    "current_forecast_finish": {
      "type": "string",
      "format": "date"
    },
    "actual_start": {
      "type": "string",
      "format": "date"
    },
    "actual_finish": {
      "type": "string",
      "format": "date"
    },
    "date_revision_reason": {
      "type": "string"
    },
    "planned_manpower": {
      "type": "number"
    },
    "actual_manpower": {
      "type": "number"
    },
    "estimated_manhours": {
      "type": "number"
    },
    "actual_manhours": {
      "type": "number"
    },
    "supplied_by": {
      "type": "string",
      "enum": [
        "DVG",
        "Contractor",
        "Client"
      ]
    },
    "selection_status": {
      "type": "string",
      "enum": [
        "Not Required",
        "Pending Selection",
        "Selected"
      ],
      "default": "Not Required"
    },
    "procurement_status": {
      "type": "string",
      "enum": [
        "Not Required",
        "To Order",
        "Ordered",
        "Delivered",
        "Installed"
      ],
      "default": "Not Required"
    },
    "expected_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "owner_access_required": {
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ],
      "default": "No"
    },
    "access_status": {
      "type": "string",
      "enum": [
        "Not Required",
        "Pending",
        "Confirmed",
        "Denied"
      ],
      "default": "Not Required"
    },
    "blocker_category": {
      "type": "string",
      "enum": [
        "Previous Work Incomplete",
        "Materials Pending",
        "Client Selection Pending",
        "Owner Access Pending",
        "Drawing / Design Clarification",
        "Contractor Manpower",
        "DVG Approval",
        "External Utility / Authority",
        "Other"
      ]
    },
    "blocker_description": {
      "type": "string"
    },
    "blocker_responsible_party": {
      "type": "string"
    },
    "blocked_since": {
      "type": "string",
      "format": "date",
      "description": "The date the work was first blocked, in Asia/Kolkata. Set once on entering Blocked, kept unchanged while the work stays blocked, and cleared when the work moves on."
    },
    "remarks": {
      "type": "string"
    },
    "latest_update": {
      "type": "string"
    },
    "latest_report_date": {
      "type": "string",
      "format": "date",
      "description": "update_date of the newest daily report applied to this task; older reports are kept as history only"
    },
    "attachment_ref": {
      "type": "string"
    },
    "source_reference": {
      "type": "string",
      "description": "Reference carried over from the source work list (an Excel row id, consultant reference or contract item). Never invented."
    },
    "import_batch_id": {
      "type": "string",
      "description": "The Import Works batch that created this task. Set only by the import operation."
    },
    "import_source_file": {
      "type": "string",
      "description": "Name of the CSV or Excel file the task came from. Set only by the import operation."
    },
    "import_source_sheet": {
      "type": "string",
      "description": "Worksheet the row was read from, e.g. Works for an Excel work list; empty for a CSV import. Set only by the import operation."
    },
    "import_row_number": {
      "type": "number",
      "description": "Row of the source file the task came from: the worksheet row for an Excel workbook, the line for a CSV. Set only by the import operation."
    },
    "source_status": {
      "type": "string",
      "description": "The status exactly as the source work list wrote it (Completed, Approved, Closed, \u2026), kept as provenance when a file reports work as done. Never the application's own operational status."
    },
    "needs_completion_verification": {
      "type": "boolean",
      "default": false,
      "description": "True when a source file reported this work complete. An authorised person must verify that reported completion before anyone may approve or close the task."
    },
    "completion_verified_by_id": {
      "type": "string"
    },
    "completion_verified_by_name": {
      "type": "string"
    },
    "completion_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_completed_by_id": {
      "type": "string"
    },
    "execution_completed_by_name": {
      "type": "string"
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_name": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "App users with active membership on this project. Maintained server-side."
    }
  },
  "required": [
    "task_ref",
    "project_id",
    "discipline",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "server-only"
      }
    },
    "update": {
      "user_condition": {
        "role": "server-only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "server-only"
      }
    }
  }
}