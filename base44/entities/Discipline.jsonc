{
  "name": "Discipline",
  "type": "object",
  "description": "Company-wide discipline list. Not project-scoped, so every signed-in user may read it; only application administrators may change it.",
  "properties": {
    "checklist_template": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Items of the inspection checklist for this discipline, in order. Empty means the starting list is used."
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "Permanent short code used for relationships"
    },
    "sort_order": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}