{
  "name": "BaselineVersion",
  "type": "object",
  "description": "Baseline versioning for a project phase. Drafts are editable by a Project Editor; once approved a version is frozen permanently and superseded rather than edited, so every approved and superseded version stays as an immutable historical record. Written only by the trusted baseline operation.",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "phase_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted",
        "Approved",
        "Superseded"
      ],
      "default": "Draft"
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "description": "Why this version was created or replaced"
    },
    "previous_baseline_version_id": {
      "type": "string"
    },
    "task_count": {
      "type": "number"
    },
    "snapshot": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Frozen baseline dates at approval: [{ task_id, task_ref, location_code, baseline_start, baseline_finish }]. Written only by the baseline operation, and never edited once the version is approved."
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Previous and new dates versus the version this one replaces"
    },
    "notes": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "App users with active membership on this project. Maintained server-side."
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "server-only"
      }
    },
    "update": {
      "user_condition": {
        "role": "server-only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "server-only"
      }
    }
  }
}