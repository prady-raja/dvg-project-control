{
  "name": "TaskDependency",
  "type": "object",
  "description": "Structure only - dependency workflows are built in a later step. Carries the same project access rules as tasks.",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "predecessor_task_id": {
      "type": "string"
    },
    "successor_task_id": {
      "type": "string"
    },
    "dependency_type": {
      "type": "string",
      "enum": [
        "Finish to Start",
        "Start to Start",
        "Finish to Finish",
        "Start to Finish"
      ],
      "default": "Finish to Start"
    },
    "lag_days": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "App users with active membership on this project. Maintained server-side."
    }
  },
  "required": [
    "predecessor_task_id",
    "successor_task_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}