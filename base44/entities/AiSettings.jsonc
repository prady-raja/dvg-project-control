{
  "name": "AiSettings",
  "type": "object",
  "description": "Administrative controls for the AI assistant. A single record configures the whole application; when it is missing the safe defaults below apply. Never holds an API key - that lives in server-side secrets only.",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "allowed_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project roles allowed to use AI, e.g. Project Editor, Project Manager, Site Engineer, Viewer. An application administrator is always allowed.",
      "default": [
        "Project Editor",
        "Project Admin",
        "Project Manager"
      ]
    },
    "model": {
      "type": "string",
      "default": "gpt-4o-mini",
      "description": "Model used for every request when the provider is an API key (OpenAI or Anthropic)"
    },
    "provider": {
      "type": "string",
      "enum": ["auto", "fetch", "base44"],
      "default": "auto",
      "description": "auto: a stored key if present, otherwise Base44 InvokeLLM. fetch: OpenAI/Anthropic-compatible API key only. base44: platform InvokeLLM only (interim)."
    },
    "provider_api": {
      "type": "string",
      "description": "openai or anthropic; blank picks from the stored key"
    },
    "base_url": {
      "type": "string",
      "description": "Optional compatible endpoint, e.g. a proxy; blank uses the provider's own"
    },
    "daily_request_limit": {
      "type": "number",
      "default": 40,
      "description": "Maximum AI requests per user per day (Asia/Kolkata day)"
    },
    "context_item_limit": {
      "type": "number",
      "default": 40,
      "description": "Maximum records of each kind sent to the provider, to bound cost and exposure"
    },
    "instructions": {
      "type": "string",
      "description": "Optional standing instructions appended to every AI request"
    },
    "notes": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}