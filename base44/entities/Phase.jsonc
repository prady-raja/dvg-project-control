{
  "name": "Phase",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "Short code used in task references, e.g. A or B"
    },
    "planned_villa_count": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Not Started",
        "Active",
        "On Hold",
        "Completed"
      ],
      "default": "Not Started"
    },
    "sort_order": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "App users with active membership on this project. Maintained server-side."
    }
  },
  "required": [
    "project_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}