{
  "name": "OwnerAccessVisit",
  "type": "object",
  "description": "One planned entry into a handed-over villa (P-09): the works and trades that need the owner's permission, bundled into one request. Confirming it sets access on the linked tasks; a no-show returns them to Owner Access Pending and is counted per villa.",
  "properties": {
    "project_id": { "type": "string" },
    "phase_id": { "type": "string" },
    "location_id": { "type": "string" },
    "visit_date": { "type": "string", "format": "date" },
    "window_start": { "type": "string", "description": "HH:MM" },
    "window_end": { "type": "string", "description": "HH:MM" },
    "status": { "type": "string", "enum": ["Requested", "Confirmed", "Done", "No-show", "Cancelled"], "default": "Requested" },
    "task_ids": { "type": "array", "items": { "type": "string" } },
    "contractor_ids": { "type": "array", "items": { "type": "string" } },
    "requested_by_name": { "type": "string" },
    "requested_at": { "type": "string", "format": "date-time" },
    "confirmed_via": { "type": "string", "enum": ["WhatsApp", "Phone", "In person"] },
    "confirmed_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" },
    "member_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "App users with active membership on this project. Maintained server-side."
    }
  },
  "required": ["project_id", "location_id", "status"],
  "rls": {
    "read": {
      "$or": [
        { "data.member_ids": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": { "user_condition": { "role": "server-only" } },
    "update": { "user_condition": { "role": "server-only" } },
    "delete": false
  }
}
