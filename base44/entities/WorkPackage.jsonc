{
  "name": "WorkPackage",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "discipline": {
      "type": "string",
      "description": "Discipline code"
    },
    "package_name": {
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "discipline",
    "package_name"
  ]
}