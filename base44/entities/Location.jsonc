{
  "name": "Location",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "phase_id": {
      "type": "string"
    },
    "villa_code": {
      "type": "string",
      "description": "Permanent physical ID, e.g. A-01 or B-05-06"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "Villa",
        "Common Area",
        "Infrastructure",
        "Project-wide"
      ],
      "default": "Villa"
    },
    "plot_numbers": {
      "type": "string",
      "description": "Original plot references, stored separately from the villa ID"
    },
    "possession_status": {
      "type": "string",
      "enum": [
        "Handed Over",
        "Not Handed Over"
      ],
      "default": "Not Handed Over"
    },
    "possession_date": {
      "type": "string",
      "format": "date"
    },
    "works_stage": {
      "type": "string",
      "enum": [
        "Not Started",
        "Under Construction",
        "Works Pending",
        "Completed"
      ],
      "default": "Not Started"
    },
    "active_status": {
      "type": "string",
      "enum": [
        "Active",
        "On Hold"
      ],
      "default": "Active"
    },
    "planned_completion_date": {
      "type": "string",
      "format": "date"
    },
    "on_hold_reason": {
      "type": "string",
      "description": "Why the villa is on hold; shown wherever held work is mentioned"
    },
    "on_hold_since": {
      "type": "string",
      "format": "date"
    },
    "villa_type": {
      "type": "string",
      "description": "The villa type (for example Type A), so floors, rooms and drawings can be copied between identical villas"
    },
    "assigned_engineer_user_id": {
      "type": "string",
      "description": "The DVG engineer responsible for this villa, as a user account. New tasks inherit it."
    },
    "assigned_engineer": {
      "type": "string"
    },
    "owner_name": { "type": "string", "description": "The villa owner, for access visits and handover (P-09)" },
    "owner_phone": { "type": "string" },
    "occupancy": { "type": "string", "enum": ["Occupied", "Vacant", "Unknown"], "default": "Unknown" },
    "access_notes": { "type": "string", "description": "Keys, security, allowed working hours" },
    "sort_order": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "App users with active membership on this project. Maintained server-side."
    }
  },
  "required": [
    "project_id",
    "villa_code",
    "location_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "server-only"
      }
    },
    "update": {
      "user_condition": {
        "role": "server-only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "server-only"
      }
    }
  }
}