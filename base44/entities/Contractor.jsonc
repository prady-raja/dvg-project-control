{
  "name": "Contractor",
  "type": "object",
  "description": "Company-wide execution teams. Not project-scoped, so every signed-in user may read the list; only application administrators may change it.",
  "properties": {
    "name": {
      "type": "string"
    },
    "classification": {
      "type": "string",
      "enum": [
        "Internal Execution Team",
        "External Contractor"
      ],
      "default": "External Contractor"
    },
    "trade": {
      "type": "string",
      "description": "Principal discipline handled, e.g. Finishes"
    },
    "contact_person": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "classification"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}