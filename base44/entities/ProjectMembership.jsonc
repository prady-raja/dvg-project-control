{
  "name": "ProjectMembership",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "Mobile number, used for Chase on WhatsApp"
    },
    "initials": {
      "type": "string",
      "description": "Two or three letters shown on avatars and used to match names"
    },
    "role": {
      "type": "string",
      "enum": [
        "Project Editor",
        "Project Admin",
        "Project Manager",
        "Site Engineer",
        "Supervisor",
        "Viewer"
      ],
      "default": "Project Editor"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "App users with active membership on this project. Maintained server-side."
    }
  },
  "required": [
    "project_id",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}